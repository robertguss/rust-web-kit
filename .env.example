# Copy to `.env` for local overrides. Names only; do not put real secrets here.
# Loaded by figment with prefix RWK_ (Phase 2). Nested keys use `__`.

# App
RWK_APP_URL=
RWK_LOG_FORMAT=
RWK_RUN_MIGRATIONS=

# Server
RWK_SERVER__HOST=
RWK_SERVER__PORT=

# Database
RWK_DATABASE_URL=

# Session
RWK_SESSION__SECRET=
RWK_SESSION__COOKIE_NAME=

# Mail (Mailpit locally: host localhost, port 1025)
RWK_MAIL__FROM=
RWK_MAIL__SMTP_HOST=
RWK_MAIL__SMTP_PORT=
RWK_MAIL__SMTP_USERNAME=
RWK_MAIL__SMTP_PASSWORD=

# OAuth — leave empty to disable a provider
RWK_OAUTH__GOOGLE_CLIENT_ID=
RWK_OAUTH__GOOGLE_CLIENT_SECRET=
RWK_OAUTH__GITHUB_CLIENT_ID=
RWK_OAUTH__GITHUB_CLIENT_SECRET=
