# Copy to `.env` for local overrides. Names only; do not put real secrets here.
# App config is loaded by figment with prefix RWK_. Nested keys use `__`.
# sqlx-cli and `#[sqlx::test]` read unprefixed DATABASE_URL.

# SQLx / tests
DATABASE_URL=

# App
RWK_ENV=
RWK_APP_URL=
RWK_LOG_FORMAT=
RWK_RUN_MIGRATIONS=

# Server
RWK_SERVER__HOST=
RWK_SERVER__PORT=
RWK_SERVER__STATIC_DIR=

# Database
RWK_DATABASE__URL=

# Session
RWK_SESSION__SECRET=
RWK_SESSION__COOKIE_NAME=

# Mail (Mailpit locally: host localhost, port 1025)
RWK_MAIL__FROM=
RWK_MAIL__SMTP_HOST=
RWK_MAIL__SMTP_PORT=
RWK_MAIL__SMTP_USERNAME=
RWK_MAIL__SMTP_PASSWORD=

# OAuth — leave empty to disable a provider
RWK_OAUTH__GOOGLE_CLIENT_ID=
RWK_OAUTH__GOOGLE_CLIENT_SECRET=
RWK_OAUTH__GITHUB_CLIENT_ID=
RWK_OAUTH__GITHUB_CLIENT_SECRET=
