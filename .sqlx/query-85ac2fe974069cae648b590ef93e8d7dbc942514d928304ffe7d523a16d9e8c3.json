  "query": "\n        UPDATE projects\n        SET\n            name = COALESCE($3, name),\n            description = COALESCE($4, description),\n            updated_at = now()\n        WHERE id = $1 AND owner_id = $2\n        RETURNING id, owner_id, name, description, created_at, updated_at\n        ",
